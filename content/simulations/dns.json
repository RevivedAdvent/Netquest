  "scenarios": [
    {
      "id": "normal",
      "label": "Normal resolution",
      "resolver": "internal",
      "cache": "empty",
      "fault": null
    },
    {
      "id": "cache_hit",
      "label": "Warm cache",
      "resolver": "internal",
      "cache": "warm",
      "fault": null,
      "query": {
        "name": "www.example.com",
        "type": "A"
      }
    },
    {
      "id": "wrong_resolver",
      "label": "Incorrect DNS server",
      "resolver": "public",
      "cache": "empty",
      "fault": null,
      "query": {
        "name": "app.corp.example",
        "type": "A"
      },
      "note": "An internal name asked of a public resolver: split-horizon DNS means the public view does not contain it."
    },
    {
      "id": "servfail",
      "label": "SERVFAIL from upstream",
      "resolver": "internal",
      "cache": "empty",
      "fault": "servfail"
    },
    {
      "id": "timeout",
      "label": "Timeout (path filtered)",
      "resolver": "internal",
      "cache": "empty",
      "fault": "timeout"
    },
    {
      "id": "stale_cache",
      "label": "Stale cached answer",
      "resolver": "internal",
      "cache": "stale",
      "fault": null,
      "query": {
        "name": "www.example.com",
        "type": "A"
      },
      "stale_value": "198.51.100.9",
      "note": "The resolver still holds an older address for this name; clients keep using it until the TTL expires."
    },
    {
      "id": "bad_record",
      "label": "Wrong authoritative record",
      "resolver": "internal",
      "cache": "empty",
      "fault": "bad_record",
      "query": {
        "name": "www.example.com",
        "type": "A"
      }
    }
  ],
  "notes": [
    "The hosts file is consulted before DNS by NSS, so a hosts entry always wins for that name.",
    "A warm cache skips the hierarchy entirely and returns the remaining TTL.",
    "A public resolver has no view of corp.example, so internal names return NXDOMAIN.",
    "TTL expiry is what people call propagation: caches persist until their own TTL runs out."
  ]
}
